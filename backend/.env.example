# =============================================================================
# Backend Environment Variables
# =============================================================================
# Copy this file to .env for local development
# NEVER commit .env to version control

# ── Server ────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
HOST=0.0.0.0

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins
# Development: http://localhost:3000
# Production: https://yourdomain.com
CORS_ORIGIN=http://localhost:3000

# ── AWS ───────────────────────────────────────────────────────────────────────
AWS_REGION=us-east-1

# For local development only — on EC2, use IAM instance role (leave these blank)
# AWS_ACCESS_KEY_ID=your-access-key-id
# AWS_SECRET_ACCESS_KEY=your-secret-access-key

# ── DynamoDB ─────────────────────────────────────────────────────────────────
# Local DynamoDB endpoint — only set for local development without real AWS
# Comment out when running against real AWS DynamoDB
DYNAMODB_ENDPOINT=http://localhost:8000

# Table name prefix — tables will be: aichat-conversations, aichat-messages, etc.
DYNAMODB_TABLE_PREFIX=aichat

# ── Logging ───────────────────────────────────────────────────────────────────
# Levels: fatal | error | warn | info | debug | trace
LOG_LEVEL=debug
# Pretty print for development (set to false for production JSON logs)
LOG_PRETTY=true

# ── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ── API ───────────────────────────────────────────────────────────────────────
API_VERSION=v1

# ── Future: Amazon Bedrock ────────────────────────────────────────────────────
# BEDROCK_REGION=us-east-1
# BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0
