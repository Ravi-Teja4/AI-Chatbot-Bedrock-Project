# =============================================================================
# Production Environment Variables — EC2 Deployment
# =============================================================================
# Copy this file to .env.prod on the EC2 instance
# NEVER commit .env.prod to version control
# On EC2, use IAM instance role for AWS credentials — leave key/secret blank

NODE_ENV=production
PORT=5000
HOST=0.0.0.0

# CORS — set to your actual frontend domain
CORS_ORIGIN=http://<EC2-PUBLIC-IP>:3000

# AWS — leave blank to use IAM instance role (recommended for EC2)
AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# DynamoDB — real AWS DynamoDB (no DYNAMODB_ENDPOINT = real service)
DYNAMODB_TABLE_PREFIX=aichat

# Logging — JSON output for CloudWatch
LOG_LEVEL=info
LOG_PRETTY=false

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# API
API_VERSION=v1

# ECR Image Registry
# REGISTRY=<account-id>.dkr.ecr.us-east-1.amazonaws.com
# IMAGE_TAG=latest
