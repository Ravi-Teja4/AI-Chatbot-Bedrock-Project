# =============================================================================
# Frontend — Multi-Stage Dockerfile (Next.js Standalone)
# =============================================================================
# Stage 1 → deps:     install dependencies
# Stage 2 → builder:  run next build with standalone output
# Stage 3 → runner:   minimal image — only the standalone output + static files
#
# Next.js standalone output traces all required files and bundles them
# into .next/standalone — no node_modules needed at runtime except what
# Next.js bundles automatically.
#
# Final image size target: ~200MB
# =============================================================================

# ── Stage 1: deps ─────────────────────────────────────────────────────────────
FROM node:20-alpine AS deps

RUN npm install -g pnpm@9.7.1

WORKDIR /app

COPY package.json pnpm-workspace.yaml pnpm-lock.yaml ./
COPY shared/package.json ./shared/
COPY frontend/package.json ./frontend/
COPY backend/package.json ./backend/

RUN pnpm install --frozen-lockfile

# ── Stage 2: builder ──────────────────────────────────────────────────────────
FROM node:20-alpine AS builder

RUN npm install -g pnpm@9.7.1

WORKDIR /app

COPY --from=deps /app/node_modules ./node_modules
COPY --from=deps /app/shared/node_modules ./shared/node_modules
COPY --from=deps /app/frontend/node_modules ./frontend/node_modules

COPY shared/ ./shared/
COPY frontend/ ./frontend/
COPY package.json pnpm-workspace.yaml ./

# Build shared types package first
RUN pnpm --filter @ai-chat/shared build

# Set build-time environment variable
# NEXT_PUBLIC_API_URL is baked into the Next.js build — must be set here.
# Override at runtime via environment variable when running the container.
ARG NEXT_PUBLIC_API_URL=http://localhost:5000
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL

# Disable Next.js telemetry during CI/CD builds
ENV NEXT_TELEMETRY_DISABLED=1

# Build the Next.js application with standalone output
RUN pnpm --filter @ai-chat/frontend build

# ── Stage 3: runner ───────────────────────────────────────────────────────────
FROM node:20-alpine AS runner

RUN addgroup --system --gid 1001 nodejs \
  && adduser --system --uid 1001 nextjs

WORKDIR /app

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1

# Copy the standalone build output
# .next/standalone contains a minimal server.js and all traced dependencies
COPY --from=builder --chown=nextjs:nodejs /app/frontend/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/frontend/.next/static ./frontend/.next/static
COPY --from=builder --chown=nextjs:nodejs /app/frontend/public ./frontend/public

USER nextjs

EXPOSE 3000

ENV PORT=3000
ENV HOSTNAME=0.0.0.0

# Health check — verifies Next.js is serving responses
HEALTHCHECK --interval=30s --timeout=10s --start-period=20s --retries=3 \
  CMD wget -qO- http://localhost:3000/ || exit 1

# server.js is generated by Next.js standalone output
CMD ["node", "frontend/server.js"]
