{
  "name": "ai-chat-platform",
  "version": "1.0.0",
  "private": true,
  "description": "Enterprise AI Chat Platform - Monorepo Root",
  "workspaces": [
    "shared",
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently --kill-others-on-fail --names \"backend,frontend\" --prefix-colors \"cyan,magenta\" \"pnpm --filter backend dev\" \"pnpm --filter frontend dev\"",
    "build": "pnpm --filter shared build && pnpm --filter backend build && pnpm --filter frontend build",
    "build:shared": "pnpm --filter shared build",
    "build:backend": "pnpm --filter shared build && pnpm --filter backend build",
    "build:frontend": "pnpm --filter shared build && pnpm --filter frontend build",
    "lint": "pnpm --filter \"./shared\" --filter \"./backend\" --filter \"./frontend\" lint",
    "lint:fix": "pnpm --filter \"./shared\" --filter \"./backend\" --filter \"./frontend\" lint:fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md,css}\" --ignore-path .prettierignore",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md,css}\" --ignore-path .prettierignore",
    "type-check": "pnpm --filter \"./shared\" --filter \"./backend\" --filter \"./frontend\" type-check",
    "clean": "pnpm --filter \"./shared\" --filter \"./backend\" --filter \"./frontend\" clean && rimraf node_modules",
    "prepare": "echo 'Run: npx husky install to enable git hooks'"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "lint-staged": "^15.2.10",
    "prettier": "^3.3.3",
    "rimraf": "^6.0.1",
    "typescript": "^5.5.4"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.7.1"
}
